# Autoresearch environment variables.
# Copy to .env (or export in your shell) and fill in real values.
# .env is gitignored — never commit real values.

# Discord webhook URLs for run notifications.
# Empty / unset → notify_discord is a no-op (fail-open).
AUTORESEARCH_DISCORD_WEBHOOK_ORB=
AUTORESEARCH_DISCORD_WEBHOOK_EMA=

# Set to "1" to use the in-process VPS backtest path instead of the
# external runner script.
AUTORESEARCH_VPS=0

# Stable market-data root. Named universes live under:
#   $AUTORESEARCH_DATA_ROOT/universes/<data_universe>/
# VPS canonical root: /root/autoresearch-data
# Current VPS universes: nasdaq8, nasdaq143
# Each universe directory must contain open/high/low/close/volume parquet files
# and should contain manifest.json for provenance.
AUTORESEARCH_DATA_ROOT=~/autoresearch-data

# VPS runner deployment inputs. Code is fetched from GitHub at the requested
# ref and resolved to an exact commit before execution.
AUTORESEARCH_VPS_HOST=
AUTORESEARCH_VPS_USER=
AUTORESEARCH_VPS_KEY=
AUTORESEARCH_VPS_DIR=/srv/autoresearch-YYYY-MM-DD
AUTORESEARCH_GIT_REPO=https://github.com/example/repo.git
AUTORESEARCH_GIT_REF=main
AUTORESEARCH_JOB=YYYY-MM-DD
